function unlockAudio(){try{if(!AC){const C=window.AudioContext||window.webkitAudioContext;if(C)AC=new C()}if(AC&&AC.state==="suspended")AC.resume()}catch(e){}}
function tone(f,t0,d,vol){if(!AC)return;const o=AC.createOscillator(),g=AC.createGain();o.type="square";o.frequency.value=f;g.gain.setValueAtTime(vol,AC.currentTime+t0);g.gain.exponentialRampToValueAtTime(0.0001,AC.currentTime+t0+d);o.connect(g);g.connect(AC.destination);o.start(AC.currentTime+t0);o.stop(AC.currentTime+t0+d+0.02)}
function playEnd(){if(!soundOn||!AC)return;[523,659,784,1047,784,1047].forEach((f,i)=>tone(f,i*0.16,0.15,0.18))}
function playWarn(){if(!soundOn||!AC)return;[880,660].forEach((f,i)=>tone(f,i*0.25,0.22,0.15))}
