// Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) 에서 복사한 값을 붙여 넣으세요.
// (이 값들은 공개돼도 괜찮은 웹앱용 설정값이에요. 가족 코드는 여기 넣지 않고 각 기기에서 입력해요.)
window.APP_CONFIG = {
  firebase: {
    apiKey: "",
    authDomain: "",
    projectId: "",
    appId: ""
  }
};

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인(익명)한 기기만, 가족 주소(familyId)를 아는 경우에만 읽고 쓸 수 있어요. 목록 조회는 막아요.
    match /families/{familyId} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;
    }
  }
}

