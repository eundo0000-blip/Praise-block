 <div class="rrow combo"><div class="cb">${ic("sun",26)}+${ic("tree",26)}</div><span class="okk">가능</span><span class="pix rb">180분</span></div><div class="rrow combo"><div class="cb">${ic("sun",26)}+${ic("bag",26)}</div><span class="okk">가능</span><span class="pix rb">180분</span></div><div class="rrow combo"><div class="cb">${ic("tree",26)}+${ic("bag",26)}</div><span class="nok">불가</span><span class="rn" style="margin-left:auto">추가는 60분만</span></div></div>
