<div id="app"></div>
<script id="state" type="application/json">{"entries":[],"days":{},"pins":{}}</script>
<script id="app-js">
const MIN=10,CAP=4;
const CRIT=[{id:"basic",icon:"maru",lab:"기본"},{id:"extra",icon:"plus",lab:"추가"},{id:"clean",icon:"broom",lab:"정리"},{id:"veg",icon:"carrot",lab:"야채"},{id:"promise",icon:"pinky",lab:"약속"},{id:"bonus",icon:"star",lab:"보너스",max:1,reason:true}];
const WHO={mom:"엄마",dad:"아빠"};
let S=JSON.parse(document.getElementById("state").textContent);S.days=S.days||{};S.pins=S.pins||{};S.entries=S.entries||[];
try{const l=localStorage.getItem("praiseBankA");if(l){const L=JSON.parse(l);if((L.savedAt||0)>(S.savedAt||0))S=L}}catch(e){}
let admin=null,tab="home",sel=null,useN=1,reason="",modal=null,artifactNS=null,armed=null;
const SESSION_MIN=120;
function lsGet(k){try{return JSON.parse(localStorage.getItem(k)||"null")}catch(e){return null}}
function lsSet(k,v){try{v===null?localStorage.removeItem(k):localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
function touchAdmin(){if(admin)lsSet("praiseAdmin",{who:admin,tab,exp:Date.now()+SESSION_MIN*60000})}
function restoreSession(){const a=lsGet("praiseAdmin");if(a&&a.exp>Date.now()&&WHO[a.who]){admin=a.who;tab=a.tab||"home"}}
const $=s=>document.querySelector(s);
const pad=n=>String(n).padStart(2,"0");
const dk=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const tk=()=>dk(new Date());
const day=()=>S.days[tk()]||{};
const setDay=o=>{S.days[tk()]={...day(),...o}};
const isToday=e=>dk(new Date(e.at))===tk();
const HOLI={"2026-01-01":"신정","2026-02-16":"설날","2026-02-17":"설날","2026-02-18":"설날","2026-03-01":"삼일절","2026-03-02":"대체공휴일","2026-05-01":"노동절","2026-05-05":"어린이날","2026-05-24":"부처님오신날","2026-05-25":"대체공휴일","2026-06-03":"지방선거","2026-06-06":"현충일","2026-07-17":"제헌절","2026-08-15":"광복절","2026-08-17":"대체공휴일","2026-09-24":"추석","2026-09-25":"추석","2026-09-26":"추석","2026-10-03":"개천절","2026-10-05":"대체공휴일","2026-10-09":"한글날","2026-12-25":"성탄절",
"2027-01-01":"신정","2027-02-06":"설날","2027-02-07":"설날","2027-02-08":"설날","2027-02-09":"대체공휴일","2027-03-01":"삼일절","2027-05-01":"노동절","2027-05-03":"대체공휴일","2027-05-05":"어린이날","2027-05-13":"부처님오신날","2027-06-06":"현충일","2027-07-17":"제헌절","2027-07-19":"대체공휴일","2027-08-15":"광복절","2027-08-16":"대체공휴일","2027-09-14":"추석","2027-09-15":"추석","2027-09-16":"추석","2027-10-03":"개천절","2027-10-04":"대체공휴일","2027-10-09":"한글날","2027-10-11":"대체공휴일","2027-12-25":"성탄절","2027-12-27":"대체공휴일"};
const DOW=["일","월","화","수","목","금","토"];
function dayKind(){const g=new Date().getDay(),hn=HOLI[tk()];if(hn)return {off:true,lab:hn};if(g===0||g===6)return {off:true,lab:DOW[g]+"요일"};return {off:false,lab:DOW[g]+"요일"}}
const weekend=()=>dayKind().off;
const earnedAll=()=>S.entries.filter(e=>e.type==="earn").length;
const usedAll=()=>S.entries.filter(e=>e.type==="use").reduce((t,e)=>t+e.n,0);
const bal=()=>earnedAll()-usedAll();
const basicMin=()=>60+(weekend()?60:0);
const extraMin=()=>{const d=day();return (d.outing||d.trip)?60:0};
const praiseTodayMin=()=>S.entries.filter(e=>e.type==="use"&&isToday(e)).reduce((t,e)=>t+e.n*MIN,0);
const totalTodayMin=()=>basicMin()+extraMin()+praiseTodayMin();
const elapsedSec=()=>{const d=day();return (d.usedSec||0)+(d.runStart?Math.max(0,(Date.now()-d.runStart)/1000):0)};
const remainSec=()=>Math.max(0,Math.round(totalTodayMin()*60-elapsedSec()));
const running=()=>!!day().runStart;
const ic=(n,s)=>`<svg width="${s}" height="${s}" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" style="display:block;flex-shrink:0"><use href="#${n}"></use></svg>`;
const todayCount=id=>S.entries.filter(e=>e.type==="earn"&&e.crit===id&&isToday(e)).length;
const critMax=c=>c.max||CAP;
const esc=t=>String(t||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const hms=s=>{const h=Math.floor(s/3600),m=Math.floor(s%3600/60),x=s%60;return h?`${h}:${pad(m)}:${pad(x)}`:`${pad(m)}:${pad(x)}`};
async function hash(s){const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode("praise-block:"+s));return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("")}
function useBlock(){const h=new Date().getHours();
 if(h<7)return "아침 7시부터 쓸 수 있어요";
 if(h>=23)return "밤 11시가 넘었어요. 내일 써요";
 if(useN>bal())return "모은 블록보다 많이 쓸 수 없어요";return ""}
let cloudOn=false;
function save(){S.savedAt=Date.now();try{localStorage.setItem("praiseBankA",JSON.stringify(S))}catch(e){}
 if(window.cloud){clearTimeout(save.t);save.t=setTimeout(()=>{window.cloud.push(S).catch(()=>toast("인터넷 연결을 확인해 주세요"))},300)}}
window.onCloudStatus=on=>{cloudOn=on;const el=document.querySelector(".cloud-st");if(el){el.classList.toggle("on",on);el.lastChild.textContent=on?" 가족과 연결됨":" 이 기기에만 저장"}};
window.onCloud=data=>{try{const R=JSON.parse(data.json);if((R.savedAt||0)>(S.savedAt||0)){S=R;S.days=S.days||{};S.pins=S.pins||{};S.entries=S.entries||[];try{localStorage.setItem("praiseBankA",JSON.stringify(S))}catch(e){}
  const typing=document.activeElement&&["reason","pin"].includes(document.activeElement.id);if(!typing)render()}}catch(e){}};
function toast(m){const t=$("#toast");if(!t)return;t.textContent=m;t.classList.add("show");clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove("show"),2200)}
function timerStop(){const d=day();if(!d.runStart)return;setDay({usedSec:Math.min(totalTodayMin()*60,elapsedSec()),runStart:null})}
function timerStart(){if(running()||remainSec()<=0)return;const o={runStart:Date.now()};if(!day().sid)o.sid=o.runStart;setDay(o)}
function timerAdjust(sec){const tot=totalTodayMin()*60,used=Math.min(tot,Math.max(0,elapsedSec()-sec));setDay(running()?{usedSec:used,runStart:Date.now()}:{usedSec:used})}
function timerReset(){setDay({usedSec:0,runStart:null,sid:Date.now()})}
let armedReset=false;

function todayPanel(){const d=day(),dk_=dayKind(),pm=praiseTodayMin(),r=remainSec(),run=running(),tot=totalTodayMin();
 const tile=(i,l,on,key,cls="")=>admin&&key?`<button class="tile ${on?"":"off"} ${cls}" data-day="${key}" aria-pressed="${on}">${ic(i,32)}${l}</button>`:`<div class="tile ${on?"":"off"} ${on?cls:""}">${ic(i,32)}${l}</div>`;
 const pct=tot?Math.round(r/(tot*60)*100):0;
 return `<div class="sec panel"><div class="ph">${ic("clock",30)}<span>오늘 게임 시간</span><span class="ptag">${new Date().getMonth()+1}/${new Date().getDate()} ${dk_.lab}</span></div>
 <div class="cat"><div class="ch"><span class="cn">기본</span><span class="ca">자동</span><b class="pix">${basicMin()}</b><span>분</span></div>
  <div class="ct">${tile("bed","60",true)}${tile("sun","+60",dk_.off,null)}</div></div>
 <div class="cat"><div class="ch"><span class="cn">추가</span><span class="ca">${admin?"눌러서 켜기":"외출·여행"}</span><b class="pix">${extraMin()}</b><span>분</span></div>
  <div class="ct">${tile("tree","+60",!!d.outing,"outing")}${tile("bag","+60",!!d.trip,"trip")}</div></div>
 <div class="cat"><div class="ch"><span class="cn">칭찬</span><span class="ca">블록에서</span><b class="pix">${pm}</b><span>분</span></div>
  <div class="ct">${tile("blk","+"+pm,pm>0,null,"gtile")}</div></div>
 <div class="sum">${ic("clock",28)}<span>합계</span><span class="pix" style="font-size:20px">${tot}</span><span>분</span><span class="window">${ic("sun",20)}<span class="pix" style="font-size:12px">7</span>~${ic("moon",20)}<span class="pix" style="font-size:12px">11</span></span></div>
 <div class="tbox ${run?"run":""}">
  <div class="trow">${ic(run?"play":"pause",30)}<span>${run?"게임 중":(d.usedSec||0)>0?"일시정지":"시작 전"}</span><span class="tleft">남은 시간</span></div>
  <div class="pix tnum" id="remainT">${hms(r)}</div>
  <div class="tbar"><span id="remainBar" style="width:${pct}%"></span></div>
  ${admin?`<button class="go ${run?"gray":""}" data-act="${run?"tstop":"tstart"}" ${!run&&r<=0?"disabled":""}>${ic(run?"pause":"play",30)} ${run?"일시정지":(d.usedSec||0)>0?"이어서 하기":"시작"}</button>
  <div class="tadj"><button class="bev" data-act="tminus" aria-label="10초 빼기">−10초</button><button class="bev ${armedReset?"armed":""}" data-act="treset">${armedReset?"한번 더":"초기화"}</button><button class="bev" data-act="tplus" aria-label="10초 더하기">+10초</button></div>`:""}
 </div>
 ${admin?`<p class="note" style="margin:6px 0 0">기본시간은 날짜(평일·주말·공휴일)로 자동 계산돼요. 외출과 여행은 함께 켤 수 없어요. 칭찬 블록을 쓰면 칭찬 칸으로 넘어와요.</p>`:""}</div>`}

function praisePanel(){const b=bal();
 const shown=Math.max(10,Math.ceil(Math.min(b,30)/5)*5);
 let slots="";for(let i=0;i<shown;i++)slots+=`<div class="slot">${i<Math.min(b,30)?ic("blk",32):""}</div>`;
 return `<div class="sec bev bal"><div class="ph green">${ic("star",30)}<span>칭찬 시간</span><span class="ptag">모아서 쓰기</span></div>
 <div class="ledger"><div>${ic("blk",34)}<span class="pix">${earnedAll()}</span><small>모은</small></div><b>−</b><div>${ic("clock",34)}<span class="pix">${usedAll()}</span><small>쓴</small></div><b>=</b><div class="left">${ic("blk",34)}<span class="pix">${b}</span><small>남은</small></div></div>
 <div class="avail">${ic("clock",40)}<span class="pix" style="font-size:34px">${b*MIN}</span><span style="font-size:30px">분</span><span style="font-size:22px">쓸 수 있어요</span></div>
 <div class="inv">${slots}</div>${b>30?`<div class="bigrow" style="font-size:22px">+${b-30}개 더!</div>`:""}</div>`}

function entryRow(e){const c=CRIT.find(x=>x.id===e.crit),earn=e.type==="earn",key=String(e.at);
 return `<li>${ic(earn?c.icon:"clock",32)}<div class="lt">${earn?c.lab:`사용 → 오늘 +${e.n*MIN}분`}${e.memo?`<div class="memo">${esc(e.memo)}</div>`:""}<div class="meta">${new Date(e.at).toLocaleString("ko-KR",{month:"numeric",day:"numeric",hour:"2-digit",minute:"2-digit"})} · ${WHO[e.who]||""}</div></div>
 <span class="amt ${earn?"plus":"minus"}">${earn?"+1":"−"+e.n}</span>
 <button class="del ${armed===key?"armed":""}" data-del="${key}" aria-label="삭제">${armed===key?"삭제":ic("trash",26)}</button></li>`}

let showRules=false;
function rulesView(){const row=(i,t,n,b)=>`<div class="rrow">${ic(i,36)}<div class="rt">${t}${n?`<div class="rn">${n}</div>`:""}</div>${b?`<span class="pix rb">${b}</span>`:""}</div>`;
 const C=[["maru","기본","기본규칙 지키기"],["plus","추가","추가규칙 지키기"],["broom","정리","정리정돈·청소"],["carrot","야채","야채 한 숟가락"],["pinky","약속","내 약속 지키기"],["star","보너스","엄마·아빠 재량"]];
 return `<div class="app rules"><div class="top"><button class="bev iconbtn" data-act="rulesclose" aria-label="돌아가기"><span class="pix" style="font-size:18px">&lt;</span></button><h1 style="font-size:30px;display:flex;align-items:center;gap:8px">${ic("book",32)}우리 규칙</h1></div>
 <div class="rstop">${ic("lock",30)}밤 12시가 넘으면 어떤 시간도 쓸 수 없어요</div>
 <div class="rsec"><div class="rh blue">${ic("bed",30)}1. 기본시간 · 자동</div>
 ${row("bed","평일 (월~금)","자려고 침대에 들어간 뒤부터","60분")}${row("sun","주말·공휴일","토·일요일, 빨간 날 · 1시간 더","120분")}${row("moon","끝나는 시간","밤 10시에 끝내기를 권해요","~11시")}</div>
